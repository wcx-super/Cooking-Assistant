# 复制本文件为 .env，再填入真实的值。.env 已被 .gitignore 忽略，不会被提交。

# 数据库配置（与 deploy/docker-compose.yml 一致）
SERVER_DB_HOST=localhost
SERVER_DB_PORT=5433
SERVER_DB_USER=server
SERVER_DB_PASS=server
SERVER_DB_BASE=server

# Redis 配置
SERVER_REDIS_HOST=localhost
SERVER_REDIS_PORT=6379
SERVER_REDIS_PASS=server

# 应用配置
SERVER_RELOAD=True
SERVER_ENVIRONMENT=dev
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# JWT 配置：换成一个随机长字符串，例如运行 python -c "import secrets; print(secrets.token_hex(32))"
SERVER_JWT_SECRET_KEY=
